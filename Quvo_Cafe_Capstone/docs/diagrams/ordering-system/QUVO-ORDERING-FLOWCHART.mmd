flowchart TD
  Start([Start]) --> Channel{Ordering channel}
  subgraph DineIn["Dine-in QR"]
    D1[Scan table QR and enter guest details] --> D2[Staff approves session]
    D2 --> D3[Browse menu, customize and build cart]
    D3 --> D4[Submit order while customer ordering is open]
  end
  subgraph Online["Online ordering"]
    O1[Browse as guest; sign in when ready to order] --> O2[New account: verify email OTP; build cart]
    O2 --> O3{Pickup or delivery?}
    O3 -->|Pickup| O4[Pay digitally and upload payment receipt]
    O3 -->|Customer-booked delivery| O5[Copy cafe pickup details and book Lalamove]
    O5 --> O6[Pay for order; upload payment receipt and Lalamove booking screenshot]
    O4 --> O7[Place order while customer ordering is open]
    O6 --> O7
  end
  subgraph Counter["Counter / walk-in POS"]
    P1[Staff enters customer order in POS] --> P2[Collect cash or confirm digital payment]
    P2 --> P3[Submit and save paid POS order]
  end
  Channel -->|Dine-in| D1
  Channel -->|Online| O1
  Channel -->|Counter| P1
  D4 --> Received[Received: awaiting cashier payment confirmation]
  O7 --> Received
  Received --> Verify{Payment confirmed by cashier?}
  Verify -->|No| Hold[Hold unpaid order and contact customer]
  Hold -. Recheck .-> Verify
  Hold -->|Cancel when needed| Cancelled([Cancelled unpaid order; retain records])
  Verify -->|Yes| Paid[Payment approved: Preparing]
  P3 --> Paid
  Paid --> Records[Record payment and receipt; deduct recipe ingredients]
  Records --> Tickets[Optional printing: separate drinks and kitchen tickets]
  Tickets --> Drinks[Staff prepares drinks if present]
  Tickets --> Food[Kitchen prepares food if present and marks food readiness]
  Drinks --> Ready[When ordered items are ready: mark Ready]
  Food --> Ready
  Ready --> Alert[Customer status tracking and supported ready alerts]
  Alert --> Fulfillment{Fulfillment}
  Fulfillment -->|Dine-in| Serve[Serve at table]
  Fulfillment -->|Pickup or counter| Pickup[Hand order to customer]
  Fulfillment -->|Delivery| Rider[Hand order to customer-booked Lalamove rider]
  Serve --> Complete[Staff marks completed: saved status served]
  Pickup --> Complete
  Rider --> Complete
  Complete --> Archive[Retain order, payment and receipt records; update reports]
  Archive --> End([End])
  Paid -. Dine-in only .-> Wifi[Customer can view configured Wi-Fi note]
  classDef process fill:#fffefb,stroke:#d9ddce,color:#263022;
  classDef success fill:#e8efdf,stroke:#aebb9d,color:#263022;
  class Paid,Ready,Complete success;
